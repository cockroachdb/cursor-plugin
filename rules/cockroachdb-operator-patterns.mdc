## 7. Backup & Restore

```sql
-- Full cluster backup
BACKUP INTO 's3://bucket/path?AUTH=implicit'
  AS OF SYSTEM TIME '-10s';

-- Incremental backup (must follow a full backup)
BACKUP INTO LATEST IN 's3://bucket/path?AUTH=implicit';

-- Scheduled daily backup with retention
CREATE SCHEDULE daily_backup
  FOR BACKUP INTO 's3://bucket/backups?AUTH=implicit'
  RECURRING '@daily'
  FULL BACKUP ALWAYS
  WITH SCHEDULE OPTIONS first_run = 'now';

-- Restore full cluster
RESTORE FROM LATEST IN 's3://bucket/path?AUTH=implicit';

-- Restore specific database
RESTORE DATABASE mydb FROM LATEST IN 's3://bucket/path?AUTH=implicit';

-- Monitor backup/restore progress
SELECT job_id, job_type, description, status, fraction_completed,
       running_status, finished
FROM crdb_internal.jobs
WHERE job_type IN ('BACKUP', 'RESTORE')
ORDER BY created DESC LIMIT 5;
```

