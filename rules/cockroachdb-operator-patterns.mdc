## 5. Diagnostic Queries

```sql
-- Cluster health overview
SELECT node_id, address, is_live, is_available,
       ranges, leases FROM crdb_internal.gossip_nodes;

-- Hot ranges (highest QPS)
SELECT range_id, start_pretty, end_pretty, lease_holder, queries_per_second
FROM crdb_internal.ranges ORDER BY queries_per_second DESC LIMIT 10;

-- Long-running queries (> 5 seconds)
SELECT query, phase, node_id, elapsed
FROM [SHOW CLUSTER QUERIES]
WHERE elapsed > '5s' ORDER BY elapsed DESC;

-- Contention events
SELECT * FROM crdb_internal.cluster_contention_events
ORDER BY count DESC LIMIT 20;

-- Running jobs (schema changes, backups, imports, changefeeds)
SELECT job_id, job_type, description, status, fraction_completed, running_status
FROM crdb_internal.jobs WHERE status = 'running';

-- High-retry transactions
SELECT key, count, max_retries
FROM crdb_internal.node_transaction_statistics
WHERE max_retries > 0 ORDER BY count DESC LIMIT 20;

-- Range distribution across nodes
SELECT node_id, count(*) AS range_count, sum(range_size) AS total_bytes
FROM crdb_internal.ranges GROUP BY node_id ORDER BY range_count DESC;

-- Unused indexes (candidates for removal — reduce write amplification)
SELECT * FROM crdb_internal.index_usage_statistics WHERE total_reads = 0;
```

